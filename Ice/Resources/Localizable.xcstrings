{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is invalid": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」無效"
          }
        }
      }
    },
    "\"%@\" is not movable": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」無法移動"
          }
        }
      }
    },
    "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」沒有回應。重新啟動之前無法移動它，其他選單列項目的移動也可能受到影響。"
          }
        }
      }
    },
    "%@ second": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 秒"
          }
        }
      }
    },
    "%@ seconds": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
